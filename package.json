{
  "name": "product-security-maturity-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Product Security Maturity Hub - internal hybrid maturity model inspired by CMM and OWASP SAMM",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:clear": "tsx scripts/clear-demo-data.ts",
    "setup": "npm install && prisma generate && prisma migrate deploy && prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "react-is": "19.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
